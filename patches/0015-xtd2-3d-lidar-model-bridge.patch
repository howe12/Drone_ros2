@@ -0,0 +1,17 @@
+<?xml version="1.0"?>
+<sdf version='1.9'>
+  <model name='x500_lidar_3d'>
+    <include merge='true'>
+      <uri>x500</uri>
+    </include>
+    <include merge='true'>
+      <uri>model://lidar_3d_v1</uri>
+      <pose>0 0 0.15 0 0 0</pose>
+    </include>
+    <joint name="Lidar3DJoint" type="fixed">
+      <parent>base_link</parent>
+      <child>link</child>
+      <pose relative_to="base_link">0 0 0.15 0 0 0</pose>
+    </joint>
+  </model>
+</sdf>
